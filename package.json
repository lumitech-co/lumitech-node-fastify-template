{
    "name": "lumitech-node-fastify-template",
    "version": "0.0.1",
    "description": "Back-end application",
    "type": "module",
    "scripts": {
        "prebuild": "npm run prisma:generate",
        "build": "rm -rf build && tsc -p ./tsconfig.build.json && tsc-alias",
        "start:dev": "NODE_ENV=development tsx watch --include \"src/**/*\" --env-file=.env ./src/index.ts",
        "start:dev:win": "tsx watch --include \"src/**/*\" --env-file=.env ./src/index.ts",
        "start:dev:worker": "NODE_ENV=development tsx watch --include \"src/**/*\" --env-file=.env ./src/worker.ts",
        "start:dev:worker:win": "tsx watch --include \"src/**/*\" --env-file=.env ./src/worker.ts",
        "commit": "cz",
        "prepare": "husky",
        "tsc-check": "tsc --noEmit",
        "lint": "eslint --max-warnings 0 --color",
        "lint:fix": "eslint --color --fix",
        "check:migrations": "node scripts/check-migrations.mjs",
        "check:drift": "node scripts/check-drift.mjs",
        "check:generators": "node scripts/check-generators.mjs",
        "lint:migrations": "squawk",
        "knip": "knip",
        "format": "prettier --write",
        "format:check": "prettier --check \"**/*.{ts,js,mjs,md,json,jsonc,yml,yaml}\"",
        "commitlint": "commitlint --edit",
        "prisma:push": "prisma db push",
        "prisma:generate": "prisma generate",
        "prisma:seed": "prisma db seed",
        "prisma:migrate:apply": "prisma migrate dev",
        "prisma:migrate:create": "prisma migrate dev --create-only",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:diagram": "prisma generate --generator dbml",
        "prisma:format": "prisma format",
        "test:unit": "vitest -c vitest-unit.config.ts",
        "test:unit:ui": "vitest -c vitest-unit.config.ts --ui",
        "test:unit:ci": "vitest run -c vitest-unit.config.ts --reporter verbose",
        "test:unit:coverage": "vitest run -c vitest-unit.config.ts --coverage",
        "test:unit:changed": "vitest run -c vitest-unit.config.ts --changed origin/main",
        "test:mutation": "stryker run",
        "test:int": "vitest -c vitest-int.config.ts",
        "test:int:ui": "vitest -c vitest-int.config.ts --ui",
        "test:int:ci": "vitest run -c vitest-int.config.ts --reporter verbose",
        "test:int:changed": "node scripts/select-int-tests.mjs --run",
        "generate:module": "node cli/module-gen/index.js",
        "generate:repository": "node cli/repository-gen/index.js"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx}": [
            "npm run format",
            "eslint --color --fix"
        ],
        "**/*.{md,json,jsonc,yml,yaml}": [
            "npm run format"
        ],
        "**/*.prisma": [
            "npm run prisma:format"
        ]
    },
    "prisma": {
        "schema": "src/database/prisma/schema.prisma"
    },
    "keywords": [
        "backend",
        "api"
    ],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=22.0.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^9.39.5",
        "@stryker-mutator/api": "^9.6.1",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testcontainers/postgresql": "^11.14.0",
        "@types/node": "^22.14.0",
        "@types/pg": "^8.15.5",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vitest/ui": "^3.2.4",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.0.1",
        "eslint": "^9.35.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-pretty-imports": "^1.3.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "knip": "^6.41.0",
        "lint-staged": "^16.1.6",
        "pg": "^8.16.3",
        "prettier": "^3.6.2",
        "prisma": "^6.16.2",
        "prisma-dbml-generator": "^0.12.0",
        "prisma-json-types-generator": "^3.6.2",
        "squawk-cli": "^2.69.0",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1090.0",
        "@aws-sdk/s3-request-presigner": "^3.1090.0",
        "@fastify/autoload": "^6.3.1",
        "@fastify/basic-auth": "^6.2.0",
        "@fastify/cors": "^11.1.0",
        "@fastify/env": "^5.0.2",
        "@fastify/error": "^4.2.0",
        "@fastify/helmet": "^13.2.0",
        "@fastify/jwt": "^10.0.0",
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/swagger": "^9.5.1",
        "@fastify/swagger-ui": "^6.1.2",
        "@google-cloud/storage": "^7.21.0",
        "@prisma/client": "^6.16.2",
        "argon2": "^0.44.0",
        "awilix": "^12.0.5",
        "bullmq": "^6.3.4",
        "close-with-grace": "^2.2.0",
        "dayjs": "^1.11.23",
        "fastify": "^5.6.0",
        "fastify-plugin": "^5.1.0",
        "fastify-type-provider-zod": "^6.0.0",
        "fluent-json-schema": "^6.0.0",
        "ioredis": "^5.11.1",
        "ipaddr.js": "^2.5.0",
        "pino-pretty": "^13.1.1",
        "ts-pattern": "^5.9.2",
        "tsc-alias": "^1.8.16",
        "zod": "^4.1.9"
    }
}
