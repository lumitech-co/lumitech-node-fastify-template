{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    // Loaded by glob, not by import: @fastify/autoload (plugins, module
    // entry points) and Awilix loadModules (services, handlers, repositories).
    "entry": [
        "src/plugins/**/*.ts",
        "src/modules/*/index.ts",
        "src/modules/**/*.{service,handler,repository}.ts",
        // A module's public API is what other modules may import.
        "src/modules/*/public.ts",
        "src/lib/**/*.service.ts",
        // The error catalog is offered to every module, used or not.
        "src/lib/errors/errors.ts",
        "cli/*/index.js",
        "scripts/*.mjs",
        // Run by Claude Code hooks (.claude/settings.json).
        "scripts/claude-hooks/*.mjs",
        // Building blocks the template ships for new projects, before a module
        // calls them (ARCHITECTURE.md, Security Defaults).
        "src/lib/safeFetch/safeFetch.ts",
        "src/lib/http/fetchWithRetry.ts",
    ],
    "project": [
        "src/**/*.{ts,prisma}",
        "cli/**/*.js",
        "scripts/**/*.mjs",
        "test/**/*.ts",
    ],
    "ignoreDependencies": [
        // Referenced as a pino transport target string.
        "pino-pretty",
    ],
}
